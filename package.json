{
  "name": "yolcu",
  "version": "1.0.0",
  "description": "Yolcu PWA",
  "scripts": {
    "start": "node server/dev.mjs",
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "gateway:build": "node tools/build-gateway.mjs",
    "gateway:dev": "wrangler dev --config server/gateway/wrangler.jsonc",
    "gateway:deploy": "wrangler deploy --config server/gateway/wrangler.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enesscigdem/yolcu.git"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "wrangler": "4.162.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
